OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low
OPENAI_FINAL_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2

VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
PULSE_CALL_PROVIDER=vapi
PULSE_VAPI_ASSISTANT_ID=
PULSE_VAPI_USE_SAVED_ASSISTANT=
PULSE_VAPI_MODEL=gpt-4o-mini
PULSE_VAPI_VOICE_ID=Elliot
PULSE_VAPI_RING_TIMEOUT_SECONDS=180
PULSE_VAPI_MAX_DURATION_SECONDS=300
PULSE_REQUIRE_INTERACTIVE_CALL=true
# Live help calls route through this response line.
# If unset, Pulse falls back to PULSE_OPERATOR_PHONE / PULSE_RECEIVING_PHONE.
PULSE_COORDINATION_PHONE=
PULSE_OPERATOR_PHONE=
# Legacy alias still accepted during migration.
PULSE_RECEIVING_PHONE=

TWILIO_ACCOUNT_SID=
# Optional preferred scoped credentials.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_FROM_NUMBER=
PULSE_MESSAGE_WEBHOOK_URL=
PULSE_MESSAGE_WEBHOOK_TOKEN=

PULSE_DISPATCH_MODE=live
PULSE_ALLOW_DRY_RUN_IN_PRODUCTION=
# Required in production for dispatch and status tokens.
PULSE_DISPATCH_SESSION_SECRET=
# Optional durable rate-limit store. Falls back to per-instance memory locally.
PULSE_RATE_LIMIT_REDIS_URL=
PULSE_RATE_LIMIT_REDIS_TOKEN=

GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Qwen agent proxy. These values belong only in the new Vercel project.
PULSE_AGENT_BACKEND_URL=
PULSE_AGENT_BACKEND_TOKEN=
PULSE_AGENT_RECEIPT_SECRET=

# Alibaba Function Compute backend values. Never expose these to the browser.
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
ALLOWED_ORIGINS=http://localhost:3000
PULSE_DEPLOYMENT_REGION=ap-southeast-1
PULSE_FUNCTION_NAME=pulse-qwen-agent
PULSE_GIT_SHA=local

ADAPTION_LABS_API_KEY=
ADAPTION_API_KEY=
PULSE_OPS_TOKEN=
